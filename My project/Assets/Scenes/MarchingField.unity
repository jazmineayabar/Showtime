      m_Calls: []
  m_text: "<size=56><b><color=#80D8FF>HOW TO PLAY</color></b></size>\n\n<b>YOUR GOAL</b>\nFollow
    the drill and reach the yellow target as each move ends.\n\n<b>CONTROLS</b>\nWASD
    \u2014 Move around the field\nSPACE \u2014 Play the notes\n\n<b>FOLLOW THE COUNTS</b>\nThere
    are 3 moves, each lasting 8 counts.\nWatch the count display and listen to the
    metronome to pace yourself.\nThe green target changes when the next move begins.
    Hit space to play the notes\n(purple triangles) on beat. \n\nYour results and
    personal best appear after all 3 moves."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
